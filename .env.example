# LLM Configuration (Keys only server-side)
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1

# Authentication & Session Settings
JWT_SECRET=
ENVIRONMENT=development
DEMO_MODE=true

# Keycloak OIDC Settings
OIDC_ISSUER_URL=http://localhost:8080/realms/security-posture
OIDC_CLIENT_ID=security-posture-app

# Database & Server
DATABASE_PATH=security_posture.sqlite3
HOST=127.0.0.1
PORT=8000
